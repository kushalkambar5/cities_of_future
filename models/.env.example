# Cities of the Future - ML Detection Service Configuration
APP_NAME="Cities of the Future - ML Detection Service"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["*"]

# Model paths (defaults to weights/ relative to models directory)
# SPEED_MODEL_PATH=weights/yolov8n.pt
# HELMET_MODEL_PATH=weights/helmet_best.pt
# SEATBELT_MODEL_PATH=weights/seat_belt_best.pt
# ACCIDENT_MODEL_PATH=weights/accident_model.pt

# Thresholds & Calibrations
DEFAULT_CONFIDENCE=0.30
SEATBELT_CONFIDENCE=0.25
ACCIDENT_CONFIDENCE=0.50
SPEED_LIMIT_KMH=60.0
SPEED_SCALE=0.3
SPEED_OFFSET=10.0
DEFAULT_EXPECTED_DIRECTION_DEG=90.0
DEFAULT_DIRECTION_TOLERANCE_DEG=90.0

# Hardware
FORCE_CPU=false
